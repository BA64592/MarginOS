# MarginOS — production secrets (never commit real values)
# Copy to .env.local for Vite; set the same keys in Vercel project settings.

# Payments — Stripe Managed Payments (K4 / §12.10)
VITE_PAYMENTS_MODE=stripe
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_EARLY_BIRD=price_...
STRIPE_PRICE_FULL=price_...
STRIPE_API_VERSION=2025-03-31.basil

# Auth — Amazon SES (K5) + optional Google (K6)
# Production domain uses eu-north-1 + noreply@marginos.online
VITE_AUTH_MODE=strict
SES_FROM_ADDRESS=noreply@marginos.online
SES_FROM_EMAIL=noreply@marginos.online
AWS_SES_REGION=eu-north-1
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
VITE_GOOGLE_CLIENT_ID=

# Demo harness (Switch to Free / K11 simulators). Leave unset in production.
# VITE_DEMO_HARNESS=false
